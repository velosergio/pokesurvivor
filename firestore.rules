rules_version = '2';

// Reglas de seguridad de PokéSurvivor.
//   saves/{uid}            partida: sólo su dueño
//   names/{apodo}          reserva de apodos únicos (en minúsculas)
//   profiles/{uid}         apodo público de cada jugador
//   friendships/{a_b}      solicitudes y amistades entre dos jugadores
//   runs/{uid}             cuándo empezó tu última partida (anti-trampas del ranking)
//   lb/{tabla}/e/{id}      ranking de tiempo aguantado
//   reports/{tabla__id__uid}  reportes de marcas sospechosas (sólo los lee el admin)
//   lbs/{tabla}            resumen con el top 50 de cada tabla
//   pres/{uid}             en línea (aproximado) · inv/{para_de} invitaciones
// Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Moderación (pantalla oculta del juego, js/ui/mod-ui.js): las cuentas de G.Config.admins.
    // <admins> (generado por tools/make_rules.js desde js/config.js, no editar a mano)
    function admin() { return signedIn() && me() in ['MufTp04DgIR02OExhPau6TopYzo2', '2qKbBtxr9PftGT3j1HXiUtv2MBa2']; }
    // </admins>
    // Tope de escrituras (20-10-2026): un documento no se puede volver a escribir
    // hasta pasados `secs` segundos desde `last` (su hora guardada). El juego
    // escribe mucho menos que eso; esto sólo frena un bucle (un juego trucado o
    // un fallo), y lo rechazado no se cobra como escritura.
    function every(last, secs) { return !(last is timestamp) || request.time > last + duration.value(secs, 's'); }

    // ---------- partida guardada ----------
    // Sólo su dueño la lee y la escribe. Ya no se marca a nadie solo (14-10-2026:
    // los márgenes contra partidas imposibles dejaban fuera del ranking a gente
    // legal). Lo único que deja a alguien sin ranking es que el admin lo banee
    // (ban = true; el campo viejo "sus" ya no cuenta para nada). El jugador no
    // puede quitarse el baneo: si está, sus guardados tienen que llevarlo.
    match /saves/{uid} {
      allow read: if signedIn() && me() == uid;
      allow read: if admin();
      // (Baneado no: sin documento, validEntry da por hecho que no hay baneo.)
      allow delete: if signedIn() && me() == uid && resource.data.get('ban', false) == false;

      allow create: if signedIn() && me() == uid && validSaveDoc() && saneSave(request.resource.data.save)
        && request.resource.data.get('ban', false) == false;
      allow update: if signedIn() && me() == uid && validSaveDoc() && saneSave(request.resource.data.save)
        && request.resource.data.get('ban', false) == resource.data.get('ban', false)
        && every(resource.data.updatedAt, 20);
      // El admin sólo puede banear o desbanear (y quitar la marca vieja).
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ban', 'sus'])
        && request.resource.data.get('ban', false) is bool;
    }

    // (El original añadió el 21-10-2026 un rev que se sube en cada guardado para
    // que una copia vieja no pise otra; esta copia sube con una transacción que
    // lee y junta lo de la nube (js/core/db.js), así que no lo usa.)

    function validSaveDoc() {
      return request.resource.data.keys().hasOnly(['save', 'updatedAt', 'v', 'sus', 'ban'])
        && request.resource.data.save is map
        && request.resource.data.v is int
        && request.resource.data.get('ban', false) is bool
        && request.resource.data.updatedAt == request.time;
    }
    function tk(s, k) { return s.get('tickets', {}).get(k, 0); }
    // Sólo que los números tengan sentido (el juego ya los limpia al cargar).
    function saneSave(s) {
      return s.get('coins', 0) is number && s.get('coins', 0) >= 0
        && tk(s, 't1') is number && tk(s, 't1') >= 0
        && tk(s, 't10') is number && tk(s, 't10') >= 0;
    }

    // ---------- apodos ----------

    match /names/{lower} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && lower.size() >= 3 && lower.size() <= 16
        && lower == lower.lower();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Perfil público: apodo, 3 favoritos, título, mejores marcas y medallas.
    // Récords del perfil: sólo números (lo que pinta el perfil; nada de texto).
    function validBest(b) {
      return b is map && b.keys().hasOnly(['solo', 'group', 'level', 'bosses', 'legends', 'kills', 'medals'])
        && b.get('solo', 0) is int && b.get('group', 0) is int && b.get('level', 0) is int && b.get('bosses', 0) is int
        && b.get('legends', 0) is int && b.get('kills', 0) is int && b.get('medals', 0) is int;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'lower', 'at', 'favs', 'title', 'best', 'medals'])
        && request.resource.data.name is string
        && request.resource.data.lower == request.resource.data.name.lower()
        && request.resource.data.at == request.time
        && (!('favs' in request.resource.data) || (request.resource.data.favs is list && request.resource.data.favs.size() <= 3))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 40))
        && (!('best' in request.resource.data) || validBest(request.resource.data.best))
        && (!('medals' in request.resource.data) || (request.resource.data.medals is list && request.resource.data.medals.size() <= 8))
        // El apodo sólo se comprueba si cambia (25-10-2026): ya se comprobó al ponerlo, y
        // leerlo en cada guardado del perfil era 1 lectura de más cada vez (~400.000 al día).
        && ((resource != null && resource.data.get('lower', '') == request.resource.data.lower)
            || getAfter(/databases/$(database)/documents/names/$(request.resource.data.lower)).data.uid == me())
        && (resource == null || every(resource.data.at, 20));
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- amigos ----------
    // Un documento por pareja, con id "uidMenor_uidMayor".

    match /friendships/{pid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.users);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'names', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && me() in request.resource.data.users
        && request.resource.data.to in request.resource.data.users
        && pid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      // Sólo quien la recibe puede aceptarla.
      allow update: if signedIn()
        && resource.data.to == me()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'at', 'names'])
        && request.resource.data.status == 'ok';
      allow delete: if signedIn() && me() in resource.data.users;
    }

    // ---------- ranking ----------

    // Al empezar cada partida en solitario el servidor de Firebase apunta la hora.
    match /runs/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      // Como mucho cada 10 min: el juego lo escribe una vez por hora como mucho y una
      // hora vieja sólo deja validEntry más holgada (era la colección que más escribía, 20-10-2026).
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['startedAt', 'mode'])
        && request.resource.data.startedAt == request.time
        && (resource == null || every(resource.data.startedAt, 600));
    }

    // ---------- Desafío diario (js/net/daily-net.js) ----------
    // daily/{uid} = { d, at, claimed }: d = el último día jugado ('AAAAMMDD',
    // hora de Colombia), claimed = el último día cuyo premio por puesto se cobró.
    // El intento se gasta al EMPEZAR: d sólo avanza (un intento al día) y tiene
    // que ser hoy (con 12 h de margen por el reloj del aparato). El premio se
    // cobra una vez por día, de un día jugado y ya cerrado (01:30 del siguiente).
    function colDay(t) {
      let c = t - duration.value(5, 'h');
      return string(c.year()) + (c.month() < 10 ? '0' : '') + string(c.month()) + (c.day() < 10 ? '0' : '') + string(c.day());
    }
    function dailyStart() {
      let d = request.resource.data;
      return d.keys().hasOnly(['d', 'at', 'claimed'])
        && d.d is string && d.d.matches('[0-9]{8}') && d.at == request.time
        && d.d in [colDay(request.time - duration.value(12, 'h')), colDay(request.time), colDay(request.time + duration.value(12, 'h'))]
        && (resource == null ? d.claimed == '' : (d.d > resource.data.d && d.claimed == resource.data.claimed));
    }
    function dailyClaim() {
      let c = request.resource.data.claimed;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
        && c is string && c.matches('[0-9]{8}') && c > resource.data.claimed && c <= resource.data.d
        && request.time >= timestamp.date(int(c[0:4]), int(c[4:6]), int(c[6:8])) + duration.value(1830, 'm');
    }
    match /daily/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid && dailyStart();
      allow update: if signedIn() && me() == uid && (dailyStart() || dailyClaim());
    }
    // Tablas que escribe un navegador: las de solitario (s_...) y la del
    // Desafío del día que empezaste (x_d<día>, con su intento en daily/).
    function ownBoard(board) {
      return board.matches('s_.*')
        || (board.matches('x_d[0-9]{8}') && get(/databases/$(database)/documents/daily/$(me())).data.d == board[3:11]);
    }

    // Sólo las tablas de solitario (s_...) y del Desafío: las de grupo las escribe el
    // servidor del cooperativo con la cuenta de servicio (server/rank.js),
    // que no pasa por estas reglas. Un navegador no puede escribir en ellas.
    // Una entrada sólo se puede mejorar, nunca empeorar: el tiempo (t) o el
    // daño a Arceus (dmg, del original desde el 23-10-2026), sin bajar el otro. Anti-trampas:
    //   - no puede durar más que el tiempo real desde que empezó tu partida
    //     (runs/{uid}), con 30 s de margen; ni más de un día (el original quitó
    //     el tope de 45 min el 23-10-2026: en el minuto 35 Arceus rompe los objetos)
    //   - nivel y derrotados con margen de sobra (un grupo de 10 muy bueno)
    //   - la cuenta no puede estar baneada por el admin (saves/{uid}.ban; si aún
    //     no ha guardado nunca en la nube, no tiene documento y no está baneada)
    // b (opcional): la build (Player.buildCode), un texto corto por jugador.
    function validEntry(board, id) {
      let d = request.resource.data;
      let dmg = d.get('dmg', 0);
      let run = get(/databases/$(database)/documents/runs/$(me())).data;
      let sv = /databases/$(database)/documents/saves/$(me());
      return d.keys().hasOnly(['t', 'uids', 'names', 'dex', 'shiny', 'lv', 'kills', 'b', 'dmg', 'at'])
        && d.t is int && d.t > 0 && d.t <= 86400
        && d.t <= (request.time - run.startedAt).seconds() + 30
        && dmg is int && dmg >= 0
        && (!exists(sv) || get(sv).data.get('ban', false) == false)
        && d.lv is int && d.lv >= 1 && d.lv <= 10 + d.t / 4
        && d.kills is int && d.kills >= 0 && d.kills <= 100 + d.t * 12
        && d.uids is list && me() in d.uids
        && d.names is list && d.names.size() == d.uids.size()
        && d.dex is list && d.dex.size() == d.uids.size()
        && d.shiny is list && d.shiny.size() == d.uids.size()
        && (!('b' in d) || (d.b is list && d.b.size() == 1 && d.b[0] is string && d.b[0].size() <= 400))
        && d.at == request.time
        && ownBoard(board) && d.uids.size() == 1 && id == me()
        // (En la tabla del Desafío, una sola marca: el intento es único.)
        && (resource == null || (!board.matches('x_.*') && d.t >= resource.data.t && dmg >= resource.data.get('dmg', 0)
              && (d.t > resource.data.t || dmg > resource.data.get('dmg', 0))));
    }

    match /lb/{board}/e/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validEntry(board, id);
      allow delete: if signedIn() && (me() in resource.data.uids || admin());
    }

    // Resumen con los dos top 50 de cada tabla (lo que se lee al mirar el ranking).
    //   top:  { id: { t, uids, names, dex, shiny, lv, kills, b } }   tiempo aguantado
    //   dtop: { id: { d, uids, names, dex, shiny } }                 daño a Arceus (desde el 23-10-2026)
    //   me:   la fila que añades o mejoras (debe coincidir con tu marca validada,
    //         escrita en la misma transacción)
    //   ev / dev: la fila que sale del top / del dtop (sólo si es peor que la tuya)
    // Al borrar la cuenta: me = '' y ev (o dev) = una fila tuya que se quita.
    function validTop(board) {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data.top;
      let dold = resource == null ? {} : resource.data.get('dtop', {});
      let dnew = d.get('dtop', {});
      let dev = d.get('dev', '');
      let changed = d.top.diff(old).affectedKeys();
      return d.keys().hasOnly(['top', 'me', 'ev', 'dtop', 'dev'])
        && d.top is map && d.top.size() <= 50
        && dnew is map && dnew.size() <= 50
        && d.me is string && d.ev is string && dev is string
        && (d.me == ''
              ? (removeMine(d, old, changed, dold, dnew, dev) || adminRemove(d, old, dold, dnew))
              : addMine(board, d, old, changed, dold, dnew, dev));
    }
    // Moderación: el admin sólo puede QUITAR filas de los dos top.
    function adminRemove(d, old, dold, dnew) {
      return admin() && old.keys().hasAll(d.top.keys()) && d.top.diff(old).changedKeys().size() == 0
        && dold.keys().hasAll(dnew.keys()) && dnew.diff(dold).changedKeys().size() == 0;
    }
    // Tu fila de cada top es tu marca validada, campo a campo (sin "shiny" si no
    // hay ninguno). Sólo en las tablas de solitario y del Desafío, como validEntry.
    // (Como mucho 7 argumentos por función: dchanged se calcula dentro.)
    function addMine(board, d, old, changed, dold, dnew, dev) {
      let e = getAfter(/databases/$(database)/documents/lb/$(board)/e/$(d.me)).data;
      let dchanged = dnew.diff(dold).affectedKeys();
      return ownBoard(board) && me() in e.uids
        && changed.hasOnly([d.me, d.ev])
        && dchanged.hasOnly([d.me, dev])
        && (!(d.me in changed) || (d.me in d.top && rowOk(d.top[d.me], e)))
        && (!(d.me in dchanged) || (d.me in dnew && drowOk(dnew[d.me], e)))
        && (d.ev == '' || (d.me in d.top && !(d.ev in d.top) && d.ev in old && old[d.ev].t <= e.t))
        && (dev == '' || (d.me in dnew && !(dev in dnew) && dev in dold && dold[dev].d <= e.get('dmg', 0)));
    }
    // La fila del resumen es una COPIA exacta de la marca ya validada (validEntry):
    // también nivel, derrotados y shiny (18-10-2026: sin esto se podía meter
    // texto con código en el "nivel" y se ejecutaba en quien abría el ranking).
    // shiny es opcional: las versiones del juego de antes del 18-10 no lo ponían.
    function rowOk(row, e) {
      return row.keys().hasOnly(['t', 'uids', 'names', 'dex', 'shiny', 'lv', 'kills', 'b'])
        && row.t == e.t && row.uids == e.uids && row.names == e.names && row.dex == e.dex
        && row.lv == e.lv && row.kills == e.kills
        && (!('shiny' in row) || row.shiny == e.shiny)
        && ('b' in row ? row.b == e.b : !('b' in e));
    }
    function drowOk(row, e) {
      return row.keys().hasOnly(['d', 'uids', 'names', 'dex', 'shiny'])
        && row.d == e.get('dmg', 0) && row.d > 0 && row.uids == e.uids && row.names == e.names && row.dex == e.dex
        && (!('shiny' in row) || row.shiny == e.shiny);
    }
    function removeMine(d, old, changed, dold, dnew, dev) {
      let dchanged = dnew.diff(dold).affectedKeys();
      return (d.ev in old && me() in old[d.ev].uids && !(d.ev in d.top) && changed.hasOnly([d.ev]) && dchanged.size() == 0)
        || (dev in dold && me() in dold[dev].uids && !(dev in dnew) && dchanged.hasOnly([dev]) && changed.size() == 0);
    }

    match /lbs/{board} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validTop(board);
    }

    // Presencia aproximada: "en línea" si at es de hace menos de unos minutos.
    match /pres/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['at', 'room', 'play', 'on'])
        && request.resource.data.at == request.time
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.play is bool && request.resource.data.on is bool
        && (resource == null || every(resource.data.at, 15));
      allow delete: if signedIn() && me() == uid;
    }

    // Invitaciones a una sala: id "para_de". Sólo entre amigos confirmados.
    match /inv/{id} {
      allow read: if signedIn() && (resource == null || me() == resource.data.to || me() == resource.data.from);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'from', 'room', 'name', 'at'])
        && request.resource.data.from == me()
        && id == request.resource.data.to + '_' + me()
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.to < me() ? request.resource.data.to + '_' + me() : me() + '_' + request.resource.data.to)).data.status == 'ok';
      allow delete: if signedIn() && (me() == resource.data.to || me() == resource.data.from);
    }

    // ---------- reportes ----------
    // Un reporte por jugador y marca (id "tabla__marca__tuUid"). Los lee y
    // borra el admin desde la pantalla oculta de moderación.
    match /reports/{rid} {
      allow read, delete: if admin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['board', 'e', 'names', 't', 'by', 'at'])
        && request.resource.data.by == me()
        && request.resource.data.board is string && request.resource.data.board.size() <= 40
        && request.resource.data.e is string && request.resource.data.e.size() <= 400
        && request.resource.data.names is list && request.resource.data.names.size() <= 10
        && request.resource.data.t is int
        && request.resource.data.at == request.time
        && rid == request.resource.data.board + '__' + request.resource.data.e + '__' + me();
    }

    // Para borrar todas tus marcas al borrar la cuenta (consulta de grupo).
    match /{path=**}/e/{id} {
      allow read: if signedIn();
    }

    // Libreta de regalos del moderador (js/ui/debug-ui.js). Totales, nunca se borran.
    // mons / shinies: { dex: true }, Pokémon regalados (cada escritura añade uno solo).
    function gm(d, k) { return d.get(k, {}); }
    // Mapas de Pokémon: o iguales, o (si one) con exactamente un dex nuevo entre los dos y nada quitado ni cambiado.
    function monsStep(n, o, one) {
      let dm = gm(n, 'mons').diff(gm(o, 'mons'));
      let ds = gm(n, 'shinies').diff(gm(o, 'shinies'));
      return gm(n, 'mons') is map && gm(n, 'shinies') is map
        && gm(n, 'mons').size() <= 2000 && gm(n, 'shinies').size() <= 2000
        && dm.removedKeys().size() == 0 && dm.changedKeys().size() == 0
        && ds.removedKeys().size() == 0 && ds.changedKeys().size() == 0
        && dm.addedKeys().size() + ds.addedKeys().size() == (one ? 1 : 0);
    }
    function grantShape() {
      return request.resource.data.keys().hasOnly(['coins', 't10', 'at', 'mons', 'shinies'])
        && request.resource.data.coins is int
        && request.resource.data.t10 is int
        && request.resource.data.at == request.time;
    }
    match /grants/{uid} {
      allow read: if admin() || (signedIn() && me() == uid);

      allow create: if admin() && grantShape()
        && ((request.resource.data.coins == 100000 && request.resource.data.t10 == 0 && monsStep(request.resource.data, {}, false))
            || (request.resource.data.t10 == 100 && request.resource.data.coins == 0 && monsStep(request.resource.data, {}, false))
            || (request.resource.data.coins == 0 && request.resource.data.t10 == 0 && monsStep(request.resource.data, {}, true)));

      allow update: if admin() && grantShape()
        && ((request.resource.data.coins == resource.data.coins + 100000
              && request.resource.data.t10 == resource.data.t10
              && monsStep(request.resource.data, resource.data, false))
            || (request.resource.data.t10 == resource.data.t10 + 100
              && request.resource.data.coins == resource.data.coins
              && monsStep(request.resource.data, resource.data, false))
            || (request.resource.data.coins == resource.data.coins
              && request.resource.data.t10 == resource.data.t10
              && monsStep(request.resource.data, resource.data, true)));

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
